# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_DIR=/app/wbs
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_DEMO_BOOTSTRAP=1

# Database
USE_POSTGRES=1
POSTGRES_DB=balance
POSTGRES_USER=balance
POSTGRES_PASSWORD=balance
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Demo Mode
DJANGO_DEMO_BOOTSTRAP=1
# ── BLE Bridge (expo-start.sh / ble-bridge-start.sh) ──────────────────────
# Credentials must match a Django user (bootstrap_superuser creates admin/admin)
BLE_USERNAME=admin
BLE_PASSWORD=admin
# Patient and Device PKs to attach live BLE sessions to
BLE_PATIENT_ID=1
BLE_DEVICE_ID=1
# BLE advertised name of the insole board
BLE_DEVICE_NAME=STEPPA
# Django API base URL (host-side, since bridge runs on the Mac, not in Docker)
BLE_BASE_URL=http://127.0.0.1:8000
